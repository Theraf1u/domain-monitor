#!/usr/bin/env bash
# Domain Monitor Server CLI.
#
#   domain-monitor-server            интерактивное меню управления
#   domain-monitor-server status     статус контейнера + healthcheck
#   domain-monitor-server start      запустить сервис
#   domain-monitor-server stop       остановить сервис
#   domain-monitor-server restart    перезапустить сервис
#   domain-monitor-server logs       смотреть логи
#   domain-monitor-server update     забрать код, пересобрать, перезапустить
#   domain-monitor-server uninstall  удалить контейнер/образ/данные (с подтверждением)
#   domain-monitor-server doctor     запустить диагностику
#   domain-monitor-server backup     сделать бэкап БД + конфига в ./backups
#   domain-monitor-server restore <f> восстановить из файла бэкапа
#   domain-monitor-server add-node   добавить ноду в одно действие (без имени)
#   domain-monitor-server migrate-export        собрать пакет для переноса на другой сервер
#   domain-monitor-server migrate-import <файл> перенести бота с другого сервера из пакета
set -uo pipefail

# Resolve through the /usr/local/bin symlink the installer creates - a
# plain `dirname "${BASH_SOURCE[0]}"` would resolve to /usr/local/bin
# itself when invoked as `domain-monitor-server`, not the project dir.
PROJECT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
SCRIPTS_DIR="$PROJECT_DIR/scripts"

# shellcheck source=../scripts/lib.sh
source "$SCRIPTS_DIR/lib.sh"

cmd="${1:-menu}"

case "$cmd" in
    menu)      exec bash "$SCRIPTS_DIR/menu.sh" ;;
    status)    bash "$SCRIPTS_DIR/healthcheck.sh" ;;
    start)     cd "$PROJECT_DIR" && compose up -d ;;
    stop)      cd "$PROJECT_DIR" && compose stop ;;
    restart)   cd "$PROJECT_DIR" && compose restart ;;
    logs)      cd "$PROJECT_DIR" && compose logs --tail 100 -f ;;
    update)    exec bash "$SCRIPTS_DIR/update.sh" ;;
    uninstall) exec bash "$SCRIPTS_DIR/uninstall.sh" ;;
    doctor)    bash "$SCRIPTS_DIR/doctor.sh" ;;
    backup)    bash "$SCRIPTS_DIR/backup.sh" ;;
    restore)   bash "$SCRIPTS_DIR/restore.sh" "${2:-}" ;;
    add-node)  bash "$SCRIPTS_DIR/add_node.sh" ;;
    migrate-export) bash "$SCRIPTS_DIR/migrate_export.sh" ;;
    migrate-import) bash "$SCRIPTS_DIR/migrate_import.sh" "${2:-}" ;;
    -h|--help|help) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//' ;;
    *)
        echo "Неизвестная команда: $cmd" >&2
        echo "Запусти 'domain-monitor-server help' для справки." >&2
        exit 1
        ;;
esac
