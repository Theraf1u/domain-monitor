# Shared secret admin tools (Telegram bot, Web Admin, `domain-monitor-ctl`)
# use to manage nodes/settings via the API. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Port the server listens on / is published on.
PORT=8000

# Public URL the server is reachable at (shown to the operator when adding
# a node, as the SERVER_URL the new agent's installer should use).
PUBLIC_URL=https://monitor.example.com

# Telegram bot (optional - leave both blank to run the API/Web Admin only).
# BOT_TOKEN=123456:AAAA...
# ADMIN_ID=123456789

# How many days of detailed event history to keep (the aggregated domain
# list with first/last-seen and hit counts is kept forever regardless).
# Set to 0 to keep events forever.
EVENT_RETENTION_DAYS=30

# A node with no heartbeat for this many seconds is shown as offline.
NODE_OFFLINE_AFTER_SECONDS=90

LOG_LEVEL=INFO
