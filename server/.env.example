# Shared secret the REST API's X-Admin-Key auth uses for direct scripting
# (node management via curl/CLI). Day-to-day management is via the
# Telegram bot below, not this key. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Port the server listens on. The container uses host networking (see
# docker-compose.yml), so this must be a port actually free on the host -
# the installer checks for you, but if you set this by hand, verify with
# `ss -tulpn | grep :<port>` first.
PORT=8280

# Reachable address for this server (shown to you when adding a node, as
# the SERVER_URL the new agent's installer should use).
PUBLIC_URL=https://monitor.example.com

# Telegram bot - required. This is the only management interface; there
# is no web UI. Get BOT_TOKEN from @BotFather, ADMIN_ID from e.g.
# @userinfobot (your own numeric Telegram user id - only these accounts
# can use the bot, everyone else is silently ignored). Multiple admins:
# comma-separated, e.g. ADMIN_ID=111111,222222 - every listed id gets
# full access and every broadcast (new-domain notifications, backups
# sent to DM, etc).
BOT_TOKEN=
ADMIN_ID=

# If this server's own host needs a proxy to reach Telegram (e.g. Telegram
# is blocked on its network), set this - same idea as the agent's outbound
# HTTP, but for the bot's own connection to api.telegram.org. Scheme must
# be plain "socks5" or "http" (not "socks5h" - unsupported by the proxy
# library used here).
# TELEGRAM_PROXY=socks5://127.0.0.1:1080

# How many days of detailed event history to keep (the aggregated domain
# list with first/last-seen and hit counts is kept forever regardless).
# Set to 0 to keep events forever.
EVENT_RETENTION_DAYS=30

# A node with no heartbeat for this many seconds is shown as offline.
NODE_OFFLINE_AFTER_SECONDS=90

# Per-node rate limit on /api/v1/events - protects the server from a
# misbehaving or compromised agent hammering the endpoint. CAPACITY is
# the burst size (requests allowed instantly before limiting kicks in),
# PER_SECOND is the steady refill rate after that. Defaults are generous
# enough that a normal agent (one batch per BATCH_INTERVAL_SECONDS) never
# gets close - only tune this down if you have a reason to.
EVENTS_RATE_LIMIT_CAPACITY=30
EVENTS_RATE_LIMIT_PER_SECOND=5

# Backups (schedule, retention, delivery) are configured from the bot's
# 💾 Бэкапы menu, not here - nothing to set in .env for that.

LOG_LEVEL=INFO
