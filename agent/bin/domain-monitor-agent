#!/usr/bin/env bash
# Domain Monitor Agent CLI.
#
#   domain-monitor-agent            интерактивное меню управления
#   domain-monitor-agent status     статус контейнера + healthcheck
#   domain-monitor-agent start      запустить сервис
#   domain-monitor-agent stop       остановить сервис
#   domain-monitor-agent restart    перезапустить сервис
#   domain-monitor-agent logs       смотреть логи
#   domain-monitor-agent update     забрать код, пересобрать, перезапустить
#   domain-monitor-agent uninstall  удалить контейнер/образ/данные (с подтверждением)
#   domain-monitor-agent doctor     запустить диагностику
#   domain-monitor-agent backup     сделать бэкап локального буфера + конфига в ./backups
#   domain-monitor-agent restore <f> восстановить из файла бэкапа
set -uo pipefail

# Resolve through the /usr/local/bin symlink the installer creates - a
# plain `dirname "${BASH_SOURCE[0]}"` would resolve to /usr/local/bin
# itself when invoked as `domain-monitor-agent`, not the project dir.
PROJECT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
SCRIPTS_DIR="$PROJECT_DIR/scripts"

# shellcheck source=../scripts/lib.sh
source "$SCRIPTS_DIR/lib.sh"

cmd="${1:-menu}"

case "$cmd" in
    menu)      exec bash "$SCRIPTS_DIR/menu.sh" ;;
    status)    bash "$SCRIPTS_DIR/healthcheck.sh" ;;
    start)     cd "$PROJECT_DIR" && compose up -d ;;
    stop)      cd "$PROJECT_DIR" && compose stop ;;
    restart)   cd "$PROJECT_DIR" && compose restart ;;
    logs)      cd "$PROJECT_DIR" && compose logs --tail 100 -f ;;
    update)    exec bash "$SCRIPTS_DIR/update.sh" ;;
    uninstall) exec bash "$SCRIPTS_DIR/uninstall.sh" ;;
    doctor)    bash "$SCRIPTS_DIR/doctor.sh" ;;
    backup)    bash "$SCRIPTS_DIR/backup.sh" ;;
    restore)   bash "$SCRIPTS_DIR/restore.sh" "${2:-}" ;;
    -h|--help|help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//' ;;
    *)
        echo "Неизвестная команда: $cmd" >&2
        echo "Запусти 'domain-monitor-agent help' для справки." >&2
        exit 1
        ;;
esac
