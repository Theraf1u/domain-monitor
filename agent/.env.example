# Where the Domain Monitor Server is reachable.
SERVER_URL=https://monitor.example.com

# Issued by the server when the node is created there
# ("+ Add node" in Telegram/Web Admin, or `POST /api/v1/nodes`).
# Starts with "nmt_". Keep it secret - it authenticates this agent to the
# server as this specific node.
NODE_TOKEN=

# Local-only label, used in this agent's own log lines. Purely cosmetic -
# the node's real name/identity lives on the server, tied to NODE_TOKEN.
NODE_NAME=agent

# Network interface to capture on ("any" covers every interface).
INTERFACE=any

# Comma-separated detection sources to enable. Each runs its own tshark
# process. Currently implemented: tls_sni, dns.
# (HTTP Host / QUIC / Xray-log sources are on the roadmap, not yet real.)
SOURCES=tls_sni

LOG_LEVEL=INFO

# --- Advanced (defaults are fine for most deployments) ---
# BATCH_INTERVAL_SECONDS=5
# BATCH_MAX_SIZE=200
# HEARTBEAT_INTERVAL_SECONDS=30
# MAX_BUFFER_SIZE=50000
# HTTP_TIMEOUT_SECONDS=10
